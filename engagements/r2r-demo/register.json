    {
      "id": "THM-0001",
      "type": "theme",
      "l1_cycle": null,
      "l2_process": null,
      "dedup_key": "theme|undocumented-controls",
      "observation_pain_point": "Dual-review control for recons above $50K operates verbally in practice but is not documented in policy or system-enforced in the reconciliation tool -- \"lives in people's heads\". The same root gap surfaces independently in record-to-report.close (GAP-0002) and risk-policy-controls.internal-controls (GAP-0005): verbal attestation only, cannot be independently evidenced, represents audit/SOX exposure across the close and controls framework.",
      "recommended_action": "Document all controls currently relying on verbal attestation, beginning with the dual-review threshold (recons above $50K). Configure the reconciliation tool to enforce the approval requirement systematically so the control is system-observed and independently verifiable. Extend a documentation sweep to other close-related controls (consolidation handoff sequencing) where institutional knowledge substitutes for written policy.",
      "priority": "p1",
      "related_nodes": [
        "record-to-report.close",
        "risk-policy-controls.internal-controls"
      ],
      "record_status": "active",
      "review_status": "needs_review",
      "requires_human_review": true,
      "last_modified_by": "add-item",
      "last_modified_at": "2026-06-21T21:45:36+00:00"
    },
    {
