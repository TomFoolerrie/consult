      "type": "improvement",
      "l1_cycle": "record-to-report",
      "l2_process": "close",
      "tag": "automation",
      "dedup_key": "record-to-report.close|improvement|automate-accrual-workflow",
      "observation_pain_point": "Accrual entries are built in spreadsheets and manually re-keyed into the ERP each month — the controller's primary stated pain point and the leading cause of late close adjustments.",
      "recommended_action": "Automate the accrual workflow: evaluate ERP-native recurring accrual templates or a structured journal-upload integration to eliminate the spreadsheet-to-ERP re-key step.",
      "effort": "med",
      "priority": "p1",
      "source": "ingested/2026-06-21_close-walkthrough.transcript.47023e6a8544.md#L25-27",
